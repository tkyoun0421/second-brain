{
  "name": "second-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": {
      "types": "./src/*",
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --conditions=development --use-system-ca --import tsx --watch src/index.ts",
    "start": "node --use-system-ca dist/index.js",
    "mcp": "node --conditions=development --use-system-ca --import tsx src/modules/mcp/mcp-server.ts",
    "check": "tsc --noEmit",
    "build": "tsc --outDir dist && node --use-system-ca scripts/verify-production-build.mjs",
    "test": "node --conditions=development --import tsx --test src/**/*.test.ts scripts/**/*.test.ts",
    "validate:schema": "node scripts/validate-db-schema.mjs",
    "verify": "npm run check && npm run build && npm run test && npm run validate:schema"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
