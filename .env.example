# Transaction-pooler or direct PostgreSQL URL. Never expose this value to clients.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase JWT verification. Prefer the JWKS endpoint for asymmetric signing keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# At least 32 random characters. Used to sign five-minute forget-preview tokens.
MEMORY_FORGET_PREVIEW_SECRET=replace-with-a-long-random-secret

# Optional. Lets the loopback-only /verification dashboard read Memory Inbox data without
# exposing the token to the browser. Use a token with only memory:read permission.
SECOND_BRAIN_MCP_ACCESS_TOKEN=replace-with-a-memory-read-token

# Keep 127.0.0.1 locally. Set 0.0.0.0 only behind a managed HTTPS ingress.
HOST=127.0.0.1
PORT=3000
