# Transaction-pooler or direct PostgreSQL URL. Never expose this value to clients.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase JWT verification. Prefer the JWKS endpoint for asymmetric signing keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Public client key required only when the dashboard signs in automatically. It is not a service_role key.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# At least 32 random characters. Used to sign five-minute forget-preview tokens.
MEMORY_FORGET_PREVIEW_SECRET=replace-with-a-long-random-secret

# Recommended for the loopback-only /verification dashboard. The API server uses these
# server-only mcp_agent credentials to obtain and refresh a short-lived access token. The
# credentials and token are never sent to the browser. Use an agent with only memory:read.
SECOND_BRAIN_DASHBOARD_MCP_AGENT_EMAIL=dashboard-agent@example.com
SECOND_BRAIN_DASHBOARD_MCP_AGENT_PASSWORD=replace-with-a-server-only-password

# Optional legacy fallback. Prefer the automatic server-side dashboard sign-in above.
# Never expose this token to the browser.
SECOND_BRAIN_MCP_ACCESS_TOKEN=replace-with-a-memory-read-token

# Keep 127.0.0.1 locally. Set 0.0.0.0 only behind a managed HTTPS ingress.
HOST=127.0.0.1
PORT=3000
